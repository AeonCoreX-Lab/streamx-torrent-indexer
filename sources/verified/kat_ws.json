{
  "id": "kat_ws",
  "enabled": true,
  "display_name": "KickassTorrents-WS",
  "kind": "html",
  "mirrors": [
    "https://kickass.ws",
    "https://kickasstorrents.bz"
  ],
  "search_path": "/usearch/{query}/?field=time_add&sorder=desc",
  "pages": 1,
  "selectors": {
    "row": "table.data tr[id]:has(a[data-download])",
    "title": "a[class=\"cellMainLink\"]",
    "title_attr": "text",
    "magnet_location": "listing",
    "magnet": "td:nth-child(1) > div > a[data-download]",
    "magnet_attr": "href",
    "magnet_querystring_param": "url",
    "size": "td:nth-child(2)",
    "seeds": "td:nth-child(4)",
    "seeds_index": 0,
    "peers": "td:nth-child(5)",
    "peers_index": 0
  },
  "request": {
    "headers": {
      "Accept": "text/html,application/xhtml+xml",
      "Accept-Language": "en-US,en;q=0.9"
    },
    "delay_ms": 0
  },
  "origin": {
    "kind": "jackett",
    "jackett_id": "kickasstorrents-ws",
    "last_verified": null
  }
}
