{
  "id": "tgx",
  "enabled": true,
  "display_name": "TorrentGalaxy",
  "kind": "html",
  "mirrors": [
    "https://torrentgalaxy.one",
    "https://torrentgalaxy.info"
  ],
  "search_path": "/get-posts/keywords:{query}",
  "imdb_path": "/get-posts/keywords:{imdb_id}",
  "pages": 1,
  "selectors": {
    "row": "div.tgxtablerow",
    "title": "a[href^=\"/post-detail/\"]",
    "title_attr": "title",
    "magnet_location": "listing",
    "magnet": "a[href^=\"magnet:?xt=\"]",
    "magnet_attr": "href",
    "size": "div.tgxtablecell:nth-last-child(5)",
    "seeds": "div.tgxtablecell:nth-last-child(2) span font",
    "seeds_index": 0,
    "peers": "div.tgxtablecell:nth-last-child(2) span font",
    "peers_index": 1
  },
  "request": {
    "headers": {
      "Accept": "text/html,application/xhtml+xml",
      "Accept-Language": "en-US,en;q=0.9"
    },
    "delay_ms": 0
  },
  "origin": {
    "kind": "jackett",
    "jackett_id": "torrentgalaxyclone",
    "last_verified": null
  }
}
